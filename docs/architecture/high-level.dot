digraph G { graph [rankdir=LR bgcolor="#f8fafc" pad="0.35" nodesep="0.55" ranksep="0.85" splines=ortho compound=true newrank=true fontname="Arial" label=<Baglo — High-Level Architecture> labelloc=t labeljust=l fontsize=24]; node [fontname="Arial" fontsize=13 color="#d5d9d9" penwidth=1.3 margin="0.12,0.08"]; edge [fontname="Arial" fontsize=10 color="#52606d" fontcolor="#52606d" penwidth=1.8 arrowsize=0.75];
    subgraph cluster_edge { label="Client & Cloudflare Edge"; color="#0891b2"; fontcolor="#03697e"; style="rounded"; penwidth=2;
      user [shape=box style="rounded,filled" fillcolor="white" color="#0f766e" penwidth=2 label=<Web User<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">public view / signed-in trading</FONT>>];
      pages [shape=box style="rounded,filled" fillcolor="white" color="#f97316" penwidth=2 label=<Cloudflare Pages<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">React SPA + Pages Functions</FONT>>];
      r2 [shape=box style="rounded,filled" fillcolor="white" color="#f97316" penwidth=2 label=<R2 + Market Worker<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">prebuilt K-line cache</FONT>>];
      user -> pages [xlabel="HTTPS"]; pages -> r2 [xlabel="K-lines"];
    }
    subgraph cluster_aws { label="AWS Cloud · Serverless Backend"; color="#ff9900"; fontcolor="#b45309"; style="rounded"; penwidth=2;
      cognito [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-Cognito_64.png" SCALE="TRUE"/></TD><TD><B>Amazon Cognito</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">email + Google OAuth</FONT></TD></TR></TABLE>>];
      gateway [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-API-Gateway_64.png" SCALE="TRUE"/></TD><TD><B>API Gateway</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">HTTP API</FONT></TD></TR></TABLE>>];
      api [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-Lambda_64.png" SCALE="TRUE"/></TD><TD><B>API Lambda</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">Python business logic</FONT></TD></TR></TABLE>>];
      ledger [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-DynamoDB_64.png" SCALE="TRUE"/></TD><TD><B>DynamoDB</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">ledger + user state</FONT></TD></TR></TABLE>>];
      research [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-Simple-Storage-Service_64.png" SCALE="TRUE"/></TD><TD><B>Amazon S3</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">research + audit</FONT></TD></TR></TABLE>>];
      schedule [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-EventBridge_64.png" SCALE="TRUE"/></TD><TD><B>EventBridge</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">scheduled workflows</FONT></TD></TR></TABLE>>];
      workers [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-Lambda_64.png" SCALE="TRUE"/></TD><TD><B>AI Lambdas</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">analyze · select · execute</FONT></TD></TR></TABLE>>];
      secrets [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-Secrets-Manager_64.png" SCALE="TRUE"/></TD><TD><B>Secrets Manager</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">provider API keys</FONT></TD></TR></TABLE>>];
      logs [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-CloudWatch_64.png" SCALE="TRUE"/></TD><TD><B>CloudWatch</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">logs + operations</FONT></TD></TR></TABLE>>];
      cognito -> gateway [xlabel="JWT"]; gateway -> api [xlabel="invoke"]; api -> ledger; api -> research;
      schedule -> workers [xlabel="trigger"]; workers -> ledger; workers -> research; secrets -> workers [dir=back];
      api -> logs [style=dashed]; workers -> logs [style=dashed];
    }
    subgraph cluster_external { label="External Services"; color="#7c3aed"; fontcolor="#6d28d9"; style="rounded"; penwidth=2;
      market [shape=box style="rounded,filled" fillcolor="white" color="#7c3aed" penwidth=2 label=<TWSE · TPEx · Fugle<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">market data providers</FONT>>];
      gemini [shape=box style="rounded,filled" fillcolor="white" color="#7c3aed" penwidth=2 label=<Gemini<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">structured AI analysis</FONT>>];
      google [shape=box style="rounded,filled" fillcolor="white" color="#7c3aed" penwidth=2 label=<Google OAuth<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">identity provider</FONT>>];
    }
    pages -> gateway [xlabel="API calls"]; pages -> cognito [xlabel="sign in"];
    market -> api [dir=back xlabel="quotes"]; market -> workers [dir=back xlabel="features"];
    gemini -> workers [dir=back xlabel="AI"]; google -> cognito [dir=back style=dashed];
    subgraph cluster_cicd { label="Delivery Pipeline"; color="#475569"; fontcolor="#334155"; style="rounded"; penwidth=2;
      github [shape=box style="rounded,filled" fillcolor="white" color="#24292f" penwidth=2 label=<GitHub<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">dev / main branches</FONT>>];
      pipeline [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-CodePipeline_64.png" SCALE="TRUE"/></TD><TD><B>CodePipeline</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">source orchestration</FONT></TD></TR></TABLE>>];
      build [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-CodeBuild_64.png" SCALE="TRUE"/></TD><TD><B>CodeBuild</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">test + package</FONT></TD></TR></TABLE>>];
      iac [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-CloudFormation_64.png" SCALE="TRUE"/></TD><TD><B>CloudFormation</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">SAM / IaC deploy</FONT></TD></TR></TABLE>>];
      cfbuild [shape=box style="rounded,filled" fillcolor="white" color="#f97316" penwidth=2 label=<Cloudflare Build<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">Pages + Worker deploy</FONT>>];
      github -> pipeline -> build -> iac; github -> cfbuild [style=dashed];
    }
    iac -> gateway [style=dashed xlabel="deploy"]; cfbuild -> pages [style=dashed xlabel="deploy"];
    }