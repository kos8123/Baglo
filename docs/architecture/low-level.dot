digraph G { graph [rankdir=LR bgcolor="#f8fafc" pad="0.35" nodesep="0.55" ranksep="0.85" splines=ortho compound=true newrank=true fontname="Arial" label=<Baglo — Low-Level Architecture> labelloc=t labeljust=l fontsize=24]; node [fontname="Arial" fontsize=13 color="#d5d9d9" penwidth=1.3 margin="0.12,0.08"]; edge [fontname="Arial" fontsize=10 color="#52606d" fontcolor="#52606d" penwidth=1.8 arrowsize=0.75];
    subgraph cluster_client { label="Browser & Cloudflare Edge"; color="#0891b2"; fontcolor="#03697e"; style="rounded"; penwidth=2;
      browser [shape=box style="rounded,filled" fillcolor="white" color="#0f766e" penwidth=2 label=<Browser<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">React + TypeScript SPA</FONT>>];
      pages [shape=box style="rounded,filled" fillcolor="white" color="#f97316" penwidth=2 label=<Cloudflare Pages<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">static assets + SPA fallback</FONT>>];
      edgefn [shape=box style="rounded,filled" fillcolor="white" color="#f97316" penwidth=2 label=<Pages Function<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">/market/history edge API</FONT>>];
      r2 [shape=box style="rounded,filled" fillcolor="white" color="#f97316" penwidth=2 label=<R2 Bucket<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">daily / weekly / monthly K-lines</FONT>>];
      sync [shape=box style="rounded,filled" fillcolor="white" color="#f97316" penwidth=2 label=<Market Sync Worker<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">backfill + after-close refresh</FONT>>];
      browser -> pages [xlabel="assets"]; browser -> edgefn [xlabel="history"]; edgefn -> r2 [xlabel="read"]; sync -> r2 [xlabel="write"];
    }
    subgraph cluster_aws { label="AWS Cloud · Isolated dev / prod stack"; color="#ff9900"; fontcolor="#b45309"; style="rounded"; penwidth=2;
      cognito [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-Cognito_64.png" SCALE="TRUE"/></TD><TD><B>Amazon Cognito</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">hosted login + JWT</FONT></TD></TR></TABLE>>];
      gateway [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-API-Gateway_64.png" SCALE="TRUE"/></TD><TD><B>API Gateway</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">HTTP API + CORS</FONT></TD></TR></TABLE>>];
      api [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-Lambda_64.png" SCALE="TRUE"/></TD><TD><B>API Lambda</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">public + protected routes</FONT></TD></TR></TABLE>>];
      ledger [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-DynamoDB_64.png" SCALE="TRUE"/></TD><TD><B>DynamoDB Ledger</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">cash · positions · orders · watchlist</FONT></TD></TR></TABLE>>];
      research [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-Simple-Storage-Service_64.png" SCALE="TRUE"/></TD><TD><B>Research S3</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">audit · reports · backtests</FONT></TD></TR></TABLE>>];
      schedule [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-EventBridge_64.png" SCALE="TRUE"/></TD><TD><B>EventBridge</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">Taipei schedules</FONT></TD></TR></TABLE>>];
      premarket [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-Lambda_64.png" SCALE="TRUE"/></TD><TD><B>Premarket Lambda</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">features + analysis</FONT></TD></TR></TABLE>>];
      selection [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-Lambda_64.png" SCALE="TRUE"/></TD><TD><B>Selection Lambda</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">universe + scoring</FONT></TD></TR></TABLE>>];
      aiworker [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-Lambda_64.png" SCALE="TRUE"/></TD><TD><B>AI Worker Lambda</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">risk + paper orders</FONT></TD></TR></TABLE>>];
      secrets [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-Secrets-Manager_64.png" SCALE="TRUE"/></TD><TD><B>Secrets Manager</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">Gemini · Fugle · OAuth</FONT></TD></TR></TABLE>>];
      logs [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-CloudWatch_64.png" SCALE="TRUE"/></TD><TD><B>CloudWatch</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">function logs</FONT></TD></TR></TABLE>>];
      webs3 [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-Simple-Storage-Service_64.png" SCALE="TRUE"/></TD><TD><B>Website S3</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">AWS-native static origin</FONT></TD></TR></TABLE>>];
      cdn [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_Amazon-CloudFront_64.png" SCALE="TRUE"/></TD><TD><B>CloudFront</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">optional distribution</FONT></TD></TR></TABLE>>];
      cognito -> gateway [xlabel="JWT"]; gateway -> api [xlabel="invoke"]; api -> ledger [xlabel="state"]; api -> research [xlabel="objects"];
      schedule -> premarket -> selection -> aiworker; premarket -> research; selection -> ledger; aiworker -> ledger [xlabel="paper orders"];
      secrets -> premarket [dir=back]; secrets -> selection [dir=back]; secrets -> aiworker [dir=back];
      api -> logs [style=dashed]; premarket -> logs [style=dashed]; selection -> logs [style=dashed]; aiworker -> logs [style=dashed]; webs3 -> cdn [xlabel="origin"];
    }
    subgraph cluster_providers { label="External Providers"; color="#7c3aed"; fontcolor="#6d28d9"; style="rounded"; penwidth=2;
      google [shape=box style="rounded,filled" fillcolor="white" color="#7c3aed" penwidth=2 label=<Google OAuth<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">federated sign-in</FONT>>];
      tw [shape=box style="rounded,filled" fillcolor="white" color="#7c3aed" penwidth=2 label=<TWSE / TPEx<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">official market data</FONT>>];
      fugle [shape=box style="rounded,filled" fillcolor="white" color="#7c3aed" penwidth=2 label=<Fugle<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">quote / reference price</FONT>>];
      gemini [shape=box style="rounded,filled" fillcolor="white" color="#7c3aed" penwidth=2 label=<Gemini<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">structured AI decision</FONT>>];
    }
    pages -> cognito [xlabel="login"]; pages -> gateway [xlabel="public / protected API"];
    google -> cognito [dir=back style=dashed]; tw -> sync [dir=back xlabel="daily data"]; tw -> premarket [dir=back];
    fugle -> api [dir=back xlabel="quotes"]; gemini -> selection [dir=back xlabel="analysis"];
    subgraph cluster_cicd { label="CI/CD"; color="#475569"; fontcolor="#334155"; style="rounded"; penwidth=2;
      github [shape=box style="rounded,filled" fillcolor="white" color="#24292f" penwidth=2 label=<GitHub<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">dev / main</FONT>>];
      pipeline [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-CodePipeline_64.png" SCALE="TRUE"/></TD><TD><B>CodePipeline</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">branch pipeline</FONT></TD></TR></TABLE>>];
      build [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-CodeBuild_64.png" SCALE="TRUE"/></TD><TD><B>CodeBuild</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">test + SAM package</FONT></TD></TR></TABLE>>];
      iac [shape=plain label=<<TABLE BORDER="1" COLOR="#d5d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="54" HEIGHT="54"><IMG SRC="/tmp/baglo-architecture-icons/Arch_AWS-CloudFormation_64.png" SCALE="TRUE"/></TD><TD><B>CloudFormation</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#5f6b7a">backend + IaC</FONT></TD></TR></TABLE>>];
      cfbuild [shape=box style="rounded,filled" fillcolor="white" color="#f97316" penwidth=2 label=<Cloudflare Build<BR/><FONT POINT-SIZE="10" COLOR="#5f6b7a">Pages + Worker</FONT>>];
      github -> pipeline -> build -> iac; github -> cfbuild [style=dashed];
    }
    iac -> gateway [style=dashed xlabel="AWS deploy"]; cfbuild -> pages [style=dashed xlabel="frontend deploy"];
    }