# Backend only. Never place this value in frontend/public/config.json.
BAGLO_FUGLE_API_KEY=

# Optional AI provider (separate from Fugle). Backend only.
BAGLO_OPENAI_API_KEY=
BAGLO_OPENAI_MODEL=gpt-6.2-astra
BAGLO_OPENAI_REASONING=medium

# Active cloud provider; no automatic fallback
BAGLO_AI_PROVIDER=gemini
BAGLO_GEMINI_API_KEY=
BAGLO_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Google Search Console "HTML tag" verification token for the Cloudflare Pages home page
BAGLO_GOOGLE_SITE_VERIFICATION=
